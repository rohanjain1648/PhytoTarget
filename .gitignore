__pycache__/
*.py[cod]
.venv/
venv/
.env

# Fetched data and trained artefacts are reproducible from the pipeline.
# The repo stays small; `python -m src.fetch_chembl` etc. rebuild them.
data/raw/
data/processed/*.csv
data/processed/*.npz
models/*.joblib
models/*.npz

# Pipeline results ARE committed (~13 MB): rerunning the pipeline takes ~25 minutes
# and needs two live APIs, so anyone reading the repo should be able to inspect the
# actual ranked hits, enrichment tables and graphs without reproducing them first.
# Only the run logs are ignored, since they are machine- and timing-specific.
outputs/*.log

# Intermediate caches, rebuilt on demand from the library CSV.
data/processed/libfeatures_*.npz
data/processed/libpains.npz

.ipynb_checkpoints/
.DS_Store
